# developers.faceit.com → App → API Keys → "Server side" anahtarı
FACEIT_API_KEY=buraya_anahtarin

# Opsiyonel: veritabanı ve veri klasörü yolu (varsayılan: data/squadmind.duckdb, data/)
# SQUADMIND_DB=data/squadmind.duckdb
# SQUADMIND_DATA_DIR=data

# İşlenip FACEIT ile doğrulanan demoyu sil (veriler DB'de kalır): 1 = sil, 0 = processed/'a taşı
# SQUADMIND_AUTO_DELETE=1

# `squadmind watch` komutunun izlediği indirme klasörü (varsayılan: kullanıcı Downloads klasörü)
# DOWNLOADS_DIR=C:\Users\<kullanici>\Downloads

# Web arayüzü (squadmind web): davet kodu (link: ?davet=<kod>), oturum anahtarı, takım sahibi
# WEB_INVITE_CODE=uzun-rastgele-bir-kod
# WEB_SECRET=uzun-rastgele-bir-anahtar
# WEB_TEAM_OWNER=<takım raporunun sahibi FACEIT nickname>
# WEB_MAP=de_dust2
# WEB_REQUIRED_DEMOS=10
# FACEIT ile giriş: developers.faceit.com → App Studio → OAuth2 Client.
# Dönüş adresi (Redirect URL): https://app.squadmind.info/giris/faceit/donus
# FACEIT_CLIENT_ID=
# FACEIT_CLIENT_SECRET=
# WEB_BASE_URL=https://app.squadmind.info
