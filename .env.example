# developers.faceit.com → App → API Keys → "Server side" anahtarı
FACEIT_API_KEY=buraya_anahtarin

# Opsiyonel: veritabanı ve veri klasörü yolu (varsayılan: data/director.duckdb, data/)
# DIRECTOR_DB=data/director.duckdb
# DIRECTOR_DATA_DIR=data

# İşlenip FACEIT ile doğrulanan demoyu sil (veriler DB'de kalır): 1 = sil, 0 = processed/'a taşı
# DIRECTOR_AUTO_DELETE=1

# `director watch` komutunun izlediği indirme klasörü (varsayılan: kullanıcı Downloads klasörü)
# DOWNLOADS_DIR=C:\Users\<kullanici>\Downloads
